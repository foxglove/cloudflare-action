{
  "name": "@foxglove/cloudflare-action",
  "private": true,
  "license": "MIT",
  "description": "Deploy to Cloudflare Pages & Workers",
  "main": "dist/index.js",
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "1.11.1",
    "@actions/exec": "1.1.1",
    "@octokit/rest": "21.1.1"
  },
  "devDependencies": {
    "@foxglove/tsconfig": "^3.2.0",
    "@types/node": "22.13.0",
    "esbuild": "0.25.0",
    "prettier": "^3.8.1",
    "typescript": "5.7.3"
  }
}
